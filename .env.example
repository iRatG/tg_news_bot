# Copy this file to .env and fill in real values
# NEVER commit .env to git

# === DeepSeek AI (обязательно) ===
DEEPSEEK_API_KEY=sk-...

# === Perplexity (опционально, для fact-checking) ===
PERPLEXITY_API_KEY=pplx-...

# === Leonardo AI (опционально, картинки к постам) ===
LEONARDO_API_KEY=
LEONARDO_MODEL_ID=b24e16ff-06e3-43eb-8d33-4416c2d75876

# === Telegram (обязательно) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_channel
TELEGRAM_ADMIN_CHAT_ID=

# === База данных ===
# Локально (относительный путь):
DATABASE_URL=sqlite+aiosqlite:///./data/newsbot.db
# На VPS в Docker (абсолютный путь, 4 слеша):
# DATABASE_URL=sqlite+aiosqlite:////app/data/newsbot.db

# === Admin Panel ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# === VPS деплой ===
VPS_HOST=
VPS_USER=root
VPS_PASSWORD=
# VPS_DEPLOY_PATH по умолчанию: /opt/tg_news_bot

# === Observability (опционально) ===
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tg-newsbot

# === System ===
LOG_LEVEL=INFO
ENVIRONMENT=development
